@prefix demo: <https://example.invalid/erden/demo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

demo:PublishedArtifactShape a sh:NodeShape ;
  sh:targetClass demo:PublishedArtifact ;
  sh:property [
    sh:path rdf:type ;
    sh:hasValue demo:Artifact ;
    sh:message "published artifacts must inherit the Artifact type"
  ] .

# A SHACL-JS constraint.
demo:JsShape a sh:NodeShape ;
  sh:targetClass demo:PublishedArtifact ;
  sh:js [ a sh:JSConstraint ; sh:jsFunctionName "noGenerator" ; sh:jsLibrary [ sh:jsLibraryURL "https://example.invalid/no-generator.js" ] ] .
