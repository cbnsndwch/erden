<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!-- The FIBO convention: internal entities abbreviate namespace IRIs. -->
    <!ENTITY ex "https://example.test/formats#">
    <!ENTITY owl "http://www.w3.org/2002/07/owl#">
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#">
]>
<rdf:RDF xml:base="https://example.test/formats"
    xmlns:ex="&ex;"
    xmlns:owl="&owl;"
    xmlns:rdf="&rdf;"
    xmlns:rdfs="&rdfs;">
    <owl:Ontology rdf:about="https://example.test/formats"/>
    <owl:Class rdf:about="&ex;Animal">
        <rdfs:label xml:lang="en">Animal</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="&ex;Dog">
        <rdfs:subClassOf rdf:resource="&ex;Animal"/>
    </owl:Class>
    <owl:Class rdf:about="&ex;Cat">
        <rdfs:subClassOf rdf:resource="&ex;Animal"/>
    </owl:Class>
    <owl:ObjectProperty rdf:about="&ex;chases">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&ex;Dog"/>
                    <rdf:Description rdf:about="&ex;Cat"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="&ex;Animal"/>
    </owl:ObjectProperty>
    <owl:DatatypeProperty rdf:about="&ex;age">
        <rdfs:domain rdf:resource="&ex;Animal"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    <owl:NamedIndividual rdf:about="&ex;rex">
        <rdf:type rdf:resource="&ex;Dog"/>
        <rdfs:comment>A dog &amp; his &quot;toy&quot; &lt;ball&gt;.</rdfs:comment>
        <ex:age rdf:datatype="&xsd;integer">3</ex:age>
        <ex:chases rdf:resource="&ex;tom"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="&ex;tom">
        <rdf:type rdf:resource="&ex;Cat"/>
    </owl:NamedIndividual>
</rdf:RDF>
