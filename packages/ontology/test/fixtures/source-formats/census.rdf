<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!-- The FIBO convention: internal entities abbreviate namespace IRIs. -->
    <!ENTITY ex "https://example.test/formats#">
    <!ENTITY owl "http://www.w3.org/2002/07/owl#">
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#">
]>
<rdf:RDF xmlns:dct="http://purl.org/dc/terms/"
    xmlns:owl="&owl;"
    xmlns:rdf="&rdf;"
    xmlns:rdfs="&rdfs;">
    <owl:Ontology rdf:about="https://example.test/formats">
        <dct:title>Census</dct:title>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    <owl:Class rdf:about="&ex;Animal"/>
    <owl:Class rdf:about="&ex;Dog">
        <rdfs:subClassOf rdf:resource="&ex;Animal"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="&ex;chases"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    <owl:ObjectProperty rdf:about="&ex;chases">
        <rdf:type rdf:resource="&owl;AsymmetricProperty"/>
        <rdfs:domain rdf:resource="&ex;Animal"/>
        <rdfs:range rdf:resource="&ex;Animal"/>
        <owl:propertyDisjointWith rdf:resource="&ex;near"/>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="&ex;near">
        <rdfs:domain rdf:resource="&ex;Animal"/>
        <rdfs:range rdf:resource="&ex;Animal"/>
    </owl:ObjectProperty>
</rdf:RDF>
