{
    "name": "erden",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "files": [],
    "type": "module",
    "scripts": {
        "bootstrap:workspace": "pnpm install --frozen-lockfile --ignore-scripts",
        "build": "turbo run build",
        "build:runtime": "turbo run build",
        "build:shacl": "node shacl/qualification/build-from-source.mjs",
        "check:shacl:engine": "node shacl/qualification/build-from-source.mjs --check",
        "reasoner:build": "cd reasoner && cargo build --release --locked",
        "reasoner:build:linux": "node reasoner/qualification/build-from-source.mjs",
        "check:boundaries": "node scripts/check-boundaries.mjs",
        "check:dependency-pins": "node scripts/check-dependency-pins.mjs",
        "erden": "pnpm run build:runtime && node apps/cli/dist/bin.js",
        "check:package-packs": "pnpm run build:runtime && node scripts/check-package-packs.mjs",
        "test:cli:packed": "node scripts/test-cli-packed-install.mjs",
        "check:workspace": "pnpm run check:shacl:engine && pnpm run check:boundaries && pnpm run check:dependency-pins && pnpm run format:check && pnpm run check:package-packs && pnpm run test:cli:packed && pnpm run lint && pnpm run typecheck && pnpm run test:guards && pnpm run test:workspace",
        "format": "oxfmt .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint --type-aware .",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test:guards": "node --test scripts/test/*.test.mjs",
        "audit": "node scripts/audit-open-tree.mjs .",
        "test:reasoner:timing": "vitest run --mode timing reasoner/qualification/timing.test.ts",
        "determinism:requests": "vitest run --mode determinism reasoner/qualification/determinism.test.ts",
        "check:distribution:closure": "node reasoner/qualification/verify-distribution-closure.mjs && node shacl/qualification/verify-distribution-closure.mjs",
        "test:distribution:clean": "node reasoner/distribution/test-clean-install.mjs current",
        "test:distribution:clean:pnpm": "node reasoner/distribution/test-clean-install.mjs current-pnpm",
        "test:distribution:linux": "node reasoner/distribution/test-clean-install.mjs linux-container",
        "test:distribution:linux:pnpm": "node reasoner/distribution/test-clean-install.mjs linux-container-pnpm",
        "test:workspace": "vitest run",
        "prepublishOnly": "node scripts/refuse-publish.mjs",
        "test": "pnpm run check:workspace",
        "check:fast": "pnpm run check:workspace",
        "check": "pnpm run check:workspace"
    },
    "devDependencies": {
        "@types/node": "24.13.3",
        "oxc-parser": "0.153.0",
        "oxfmt": "0.67.0",
        "oxlint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "turbo": "2.10.12",
        "typescript": "7.0.2",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": "^24",
        "pnpm": "10.15.0"
    },
    "packageManager": "pnpm@10.15.0"
}
